# Copy to .env and fill in.

# Postgres (Render/Supabase/Neon). Leave unset to use a local SQLite file.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:./stocksage.db

# Set to false when your Postgres does not use SSL (e.g. local docker)
DB_SSL=true

# CHANGE THIS IN PRODUCTION — same value as the FastAPI backend if you are
# migrating an existing database, so already-issued tokens keep working.
JWT_SECRET=stocksage-dev-secret-change-in-production

PORT=8000
HOST=0.0.0.0

# Comma-separated allowed origins. Omit for "*".
# CORS_ORIGIN=https://stock-sage-trading-portflio-analysi.vercel.app
